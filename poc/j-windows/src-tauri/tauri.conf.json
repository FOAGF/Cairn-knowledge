{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cairn Windows test",
  "version": "0.1.0",
  "identifier": "app.cairn.wintest",
  "build": { "frontendDist": "../web" },
  "app": {
    "windows": [{ "label": "main", "title": "Cairn Windows test", "width": 900, "height": 640 }],
    "security": { "csp": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": false, "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"] }
}
